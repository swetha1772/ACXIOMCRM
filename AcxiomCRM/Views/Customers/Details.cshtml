@model Customer
@{
    ViewData["Title"] = $"Customer - {Model.CustomerName}";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <div class="d-flex align-items-center gap-2">
            <h3 class="fw-bold mb-0">@Model.CustomerName</h3>
            <span class="badge @(Model.Status == "Active" ? "bg-success" : "bg-secondary")">@Model.Status</span>
            <span class="badge bg-light text-dark border">@Model.CustomerCode</span>
        </div>
        <p class="text-muted small mb-0">Account Created on @Model.CreatedDate.ToString("MMMM dd, yyyy")</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.CustomerId" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-pencil me-1"></i> Edit Customer
        </a>
        <a asp-controller="Opportunities" asp-action="Create" asp-route-customerId="@Model.CustomerId" class="btn btn-outline-success btn-sm">
            <i class="bi bi-plus-lg me-1"></i> New Opportunity
        </a>
        <a asp-controller="FollowUps" asp-action="Create" asp-route-customerId="@Model.CustomerId" class="btn btn-outline-warning btn-sm">
            <i class="bi bi-calendar-plus me-1"></i> Schedule Follow-Up
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Back to List
        </a>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-4">
        <div class="card p-3 h-100">
            <h6 class="fw-bold text-dark border-bottom pb-2"><i class="bi bi-info-circle me-1 text-primary"></i> Account Details</h6>
            <dl class="row small mb-0">
                <dt class="col-sm-5 text-muted">Company</dt>
                <dd class="col-sm-7 fw-semibold">@(Model.CompanyName ?? "-")</dd>

                <dt class="col-sm-5 text-muted">Email</dt>
                <dd class="col-sm-7"><a href="mailto:@Model.Email">@Model.Email</a></dd>

                <dt class="col-sm-5 text-muted">Phone</dt>
                <dd class="col-sm-7">@Model.Phone</dd>

                <dt class="col-sm-5 text-muted">Address</dt>
                <dd class="col-sm-7">@(Model.Address ?? "-")</dd>

                <dt class="col-sm-5 text-muted">Location</dt>
                <dd class="col-sm-7">@((Model.City != null || Model.State != null) ? $"{Model.City}, {Model.State}" : "-")</dd>

                <dt class="col-sm-5 text-muted">Account Owner</dt>
                <dd class="col-sm-7 fw-semibold">@(Model.Owner?.FullName ?? "Unassigned")</dd>
            </dl>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card">
            <div class="card-header bg-white">
                <ul class="nav nav-tabs card-header-tabs" id="customerTabs" role="tablist">
                    <li class="nav-item">
                        <button class="nav-link active" id="opps-tab" data-bs-toggle="tab" data-bs-target="#opps" type="button" role="tab">
                            Opportunities (@Model.Opportunities.Count)
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link" id="followups-tab" data-bs-toggle="tab" data-bs-target="#followups" type="button" role="tab">
                            Follow-Ups (@Model.FollowUps.Count)
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link" id="activities-tab" data-bs-toggle="tab" data-bs-target="#activities" type="button" role="tab">
                            Activities (@Model.Activities.Count)
                        </button>
                    </li>
                </ul>
            </div>
            <div class="card-body">
                <div class="tab-content" id="customerTabsContent">
                    <!-- Opportunities Tab -->
                    <div class="tab-pane fade show active" id="opps" role="tabpanel">
                        @if (Model.Opportunities.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-sm table-hover align-middle">
                                    <thead>
                                        <tr>
                                            <th>Opportunity</th>
                                            <th>Amount</th>
                                            <th>Stage</th>
                                            <th>Prob.</th>
                                            <th>Close Date</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var opp in Model.Opportunities)
                                        {
                                            <tr>
                                                <td class="fw-semibold">
                                                    <a asp-controller="Opportunities" asp-action="Details" asp-route-id="@opp.OpportunityId">
                                                        @opp.OpportunityName
                                                    </a>
                                                </td>
                                                <td>@opp.Amount.ToString("C0")</td>
                                                <td><span class="badge bg-primary">@opp.Stage</span></td>
                                                <td>@opp.Probability%</td>
                                                <td class="text-muted small">@opp.ExpectedCloseDate.ToString("yyyy-MM-dd")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <p class="text-muted text-center py-3 mb-0">No opportunities linked to this customer.</p>
                        }
                    </div>

                    <!-- Follow-ups Tab -->
                    <div class="tab-pane fade" id="followups" role="tabpanel">
                        @if (Model.FollowUps.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-sm table-hover align-middle">
                                    <thead>
                                        <tr>
                                            <th>Subject</th>
                                            <th>Type</th>
                                            <th>Date</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var fu in Model.FollowUps)
                                        {
                                            <tr>
                                                <td class="fw-semibold">@fu.Subject</td>
                                                <td><span class="badge bg-light text-dark border">@fu.FollowUpType</span></td>
                                                <td class="small">@fu.FollowUpDate.ToString("yyyy-MM-dd")</td>
                                                <td>
                                                    <span class="badge @(fu.Status == "Planned" ? "bg-warning text-dark" : fu.Status == "Completed" ? "bg-success" : "bg-secondary")">
                                                        @fu.Status
                                                    </span>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <p class="text-muted text-center py-3 mb-0">No follow-ups recorded for this customer.</p>
                        }
                    </div>

                    <!-- Activities Tab -->
                    <div class="tab-pane fade" id="activities" role="tabpanel">
                        @if (Model.Activities.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-sm table-hover align-middle">
                                    <thead>
                                        <tr>
                                            <th>Type</th>
                                            <th>Subject</th>
                                            <th>Date</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var act in Model.Activities)
                                        {
                                            <tr>
                                                <td><span class="badge bg-secondary">@act.ActivityType</span></td>
                                                <td class="fw-semibold">@act.Subject</td>
                                                <td class="small">@act.ActivityDate.ToString("yyyy-MM-dd")</td>
                                                <td><span class="badge bg-success">@act.Status</span></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <p class="text-muted text-center py-3 mb-0">No activities logged for this customer.</p>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
