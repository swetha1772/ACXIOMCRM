@model UserEditViewModel
@{
    ViewData["Title"] = "Manage User";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h3 class="fw-bold mb-0">Manage User: @Model.FullName</h3>
                <p class="text-muted small mb-0">Login Email: @Model.Email</p>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Back to List
            </a>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="Email" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label small fw-semibold">Full Name <span class="text-danger">*</span></label>
                        <input asp-for="FullName" class="form-control" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Role" class="form-label small fw-semibold">Assigned Role <span class="text-danger">*</span></label>
                        <select asp-for="Role" asp-items="Model.RolesList" class="form-select"></select>
                        <span asp-validation-for="Role" class="text-danger small"></span>
                    </div>

                    <div class="mb-3 form-check form-switch">
                        <input asp-for="IsActive" class="form-check-input" id="activeSwitch" />
                        <label class="form-check-label fw-semibold" for="activeSwitch">Account Active (Allows Login)</label>
                    </div>

                    <div class="mb-3 form-check form-switch">
                        <input asp-for="UnlockAccount" class="form-check-input" id="unlockSwitch" />
                        <label class="form-check-label fw-semibold" for="unlockSwitch">Unlock Account & Reset Failed Attempts</label>
                    </div>

                    <div class="border rounded p-3 mb-3 bg-light">
                        <label asp-for="NewPassword" class="form-label small fw-semibold">Reset Password (Leave blank to keep current)</label>
                        <input asp-for="NewPassword" class="form-control" placeholder="Enter new password to override" />
                        <span asp-validation-for="NewPassword" class="text-danger small"></span>
                    </div>

                    <hr class="my-4" />

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-light px-4">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-check-lg me-1"></i> Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
