@model FollowUpCreateEditViewModel
@{
    ViewData["Title"] = "Edit Follow-Up";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h3 class="fw-bold mb-0">Reschedule / Edit Follow-Up</h3>
                <p class="text-muted small mb-0">Update follow-up status, schedule or conversation remarks</p>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Back to List
            </a>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <form asp-action="Edit" asp-route-id="@Model.FollowUpId" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="FollowUpId" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                    <div class="row g-3">
                        <div class="col-md-12">
                            <label asp-for="Subject" class="form-label small fw-semibold">Subject / Objective <span class="text-danger">*</span></label>
                            <input asp-for="Subject" class="form-control" />
                            <span asp-validation-for="Subject" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="FollowUpDate" class="form-label small fw-semibold">Follow-Up Date <span class="text-danger">*</span></label>
                            <input asp-for="FollowUpDate" type="date" class="form-control" />
                            <span asp-validation-for="FollowUpDate" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="FollowUpType" class="form-label small fw-semibold">Follow-Up Type <span class="text-danger">*</span></label>
                            <select asp-for="FollowUpType" class="form-select">
                                <option value="Call">Call</option>
                                <option value="Meeting">Meeting</option>
                                <option value="Email">Email</option>
                                <option value="Demo">Demo</option>
                                <option value="Other">Other</option>
                            </select>
                            <span asp-validation-for="FollowUpType" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CustomerId" class="form-label small fw-semibold">Related Customer</label>
                            <select asp-for="CustomerId" asp-items="Model.CustomersList" class="form-select">
                                <option value="">-- None / Select Customer --</option>
                            </select>
                            <span asp-validation-for="CustomerId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="LeadId" class="form-label small fw-semibold">Related Lead</label>
                            <select asp-for="LeadId" asp-items="Model.LeadsList" class="form-select">
                                <option value="">-- None / Select Lead --</option>
                            </select>
                            <span asp-validation-for="LeadId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Status" class="form-label small fw-semibold">Status</label>
                            <select asp-for="Status" class="form-select">
                                <option value="Planned">Planned</option>
                                <option value="Completed">Completed</option>
                                <option value="Missed">Missed</option>
                                <option value="Cancelled">Cancelled</option>
                            </select>
                            <span asp-validation-for="Status" class="text-danger small"></span>
                        </div>

                        @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                        {
                            <div class="col-md-6">
                                <label asp-for="AssignedTo" class="form-label small fw-semibold">Assign User</label>
                                <select asp-for="AssignedTo" asp-items="Model.UsersList" class="form-select">
                                    <option value="">-- Assign User --</option>
                                </select>
                                <span asp-validation-for="AssignedTo" class="text-danger small"></span>
                            </div>
                        }

                        <div class="col-md-12">
                            <label asp-for="Remarks" class="form-label small fw-semibold">Remarks</label>
                            <textarea asp-for="Remarks" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Remarks" class="text-danger small"></span>
                        </div>
                    </div>

                    <hr class="my-4" />

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-light px-4">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-check-lg me-1"></i> Update Follow-Up
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
