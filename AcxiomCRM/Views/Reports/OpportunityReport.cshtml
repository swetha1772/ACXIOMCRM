@model OpportunityReportViewModel
@{
    ViewData["Title"] = "Opportunity Pipeline Report";
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h3 class="fw-bold mb-0">Opportunity Pipeline Report</h3>
        <p class="text-muted small mb-0">Stage distribution, probability weightings and gross pipeline aggregates</p>
    </div>
    <div class="d-flex gap-2">
        <button onclick="window.print()" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-printer me-1"></i> Print / Export
        </button>
        <a asp-action="Index" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Reports Home
        </a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card p-3 bg-white text-center">
            <div class="text-muted small text-uppercase fw-semibold">Gross Opportunity Value</div>
            <h3 class="fw-bold text-primary mb-0">@Model.TotalAmount.ToString("C0")</h3>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card p-3 bg-white text-center">
            <div class="text-muted small text-uppercase fw-semibold">Total Weighted Value</div>
            <h3 class="fw-bold text-success mb-0">@Model.TotalWeightedAmount.ToString("C0")</h3>
        </div>
    </div>
</div>

<div class="card p-3 mb-4">
    <form method="get" asp-action="OpportunityReport" class="row g-2 align-items-center">
        <div class="col-md-6">
            <select name="stageFilter" class="form-select">
                <option value="">All Pipeline Stages</option>
                <option value="Qualification" selected="@(Model.StageFilter == "Qualification")">Qualification</option>
                <option value="Proposal" selected="@(Model.StageFilter == "Proposal")">Proposal</option>
                <option value="Negotiation" selected="@(Model.StageFilter == "Negotiation")">Negotiation</option>
                <option value="Won" selected="@(Model.StageFilter == "Won")">Won</option>
                <option value="Lost" selected="@(Model.StageFilter == "Lost")">Lost</option>
            </select>
        </div>
        <div class="col-md-6 d-flex gap-2">
            <button type="submit" class="btn btn-secondary px-3 w-100">Filter</button>
            <a asp-action="OpportunityReport" class="btn btn-outline-secondary px-3">Reset</a>
        </div>
    </form>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Opportunity Name</th>
                    <th>Customer</th>
                    <th>Amount</th>
                    <th>Stage</th>
                    <th>Probability</th>
                    <th>Weighted Value</th>
                    <th>Expected Close</th>
                    <th>Owner</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Opportunities.Any())
                {
                    @foreach (var o in Model.Opportunities)
                    {
                        <tr>
                            <td class="fw-bold">@o.OpportunityName</td>
                            <td>@(o.Customer?.CustomerName ?? "-")</td>
                            <td class="fw-bold">@o.Amount.ToString("C0")</td>
                            <td><span class="badge badge-stage-@(o.Stage.ToLower())">@o.Stage</span></td>
                            <td>@o.Probability%</td>
                            <td class="text-success fw-semibold">@o.WeightedAmount.ToString("C0")</td>
                            <td class="small text-muted">@o.ExpectedCloseDate.ToString("yyyy-MM-dd")</td>
                            <td class="small">@(o.AssignedUser?.FullName ?? "Unassigned")</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center py-4 text-muted">No opportunities found matching this filter.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
