@model PipelineReportViewModel
@{
    ViewData["Title"] = "Pipeline & Forecast Report";
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h3 class="fw-bold mb-0">Pipeline & Revenue Forecast Report</h3>
        <p class="text-muted small mb-0">Stage distribution, owner allocations and weighted deal estimates</p>
    </div>
    <div class="d-flex gap-2">
        <button onclick="window.print()" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-printer me-1"></i> Print / Export
        </button>
        <a asp-action="Index" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Reports Home
        </a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card p-3 bg-white text-center">
            <div class="text-muted small text-uppercase fw-semibold">Total Active Pipeline</div>
            <h3 class="fw-bold text-primary mb-0">@Model.GrandTotalPipeline.ToString("C0")</h3>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card p-3 bg-white text-center">
            <div class="text-muted small text-uppercase fw-semibold">Total Weighted Pipeline</div>
            <h3 class="fw-bold text-success mb-0">@Model.GrandTotalWeighted.ToString("C0")</h3>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Stage Breakdown -->
    <div class="col-lg-6">
        <div class="card p-3 h-100">
            <h6 class="fw-bold text-dark border-bottom pb-2 mb-3"><i class="bi bi-layers me-1 text-primary"></i> Stage-Wise Pipeline Breakdown</h6>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Stage</th>
                            <th>Count</th>
                            <th>Total Amount</th>
                            <th>Weighted Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model.StageSummaries)
                        {
                            <tr>
                                <td><span class="badge badge-stage-@(s.Stage.ToLower())">@s.Stage</span></td>
                                <td>@s.Count</td>
                                <td class="fw-bold">@s.TotalAmount.ToString("C0")</td>
                                <td class="text-success fw-semibold">@s.WeightedAmount.ToString("C0")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Owner Breakdown -->
    <div class="col-lg-6">
        <div class="card p-3 h-100">
            <h6 class="fw-bold text-dark border-bottom pb-2 mb-3"><i class="bi bi-person-check me-1 text-success"></i> Owner-Wise Pipeline Allocation</h6>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Sales Executive</th>
                            <th>Opportunities</th>
                            <th>Total Value</th>
                            <th>Weighted Value</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var o in Model.OwnerSummaries)
                        {
                            <tr>
                                <td class="fw-bold">@o.OwnerName</td>
                                <td>@o.Count</td>
                                <td class="fw-bold">@o.TotalAmount.ToString("C0")</td>
                                <td class="text-success fw-semibold">@o.WeightedAmount.ToString("C0")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
