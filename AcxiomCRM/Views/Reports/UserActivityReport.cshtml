@model UserActivityReportViewModel
@{
    ViewData["Title"] = "User Activity Report";
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h3 class="fw-bold mb-0">User Activity & Operational Audit</h3>
        <p class="text-muted small mb-0">System interaction metrics, creation rates, logins and completed activities</p>
    </div>
    <div class="d-flex gap-2">
        <button onclick="window.print()" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-printer me-1"></i> Print / Export
        </button>
        <a asp-action="Index" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Reports Home
        </a>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Staff Member</th>
                    <th>Role</th>
                    <th>Logins Count</th>
                    <th>Records Created</th>
                    <th>Records Updated</th>
                    <th>Activities Logged</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.UserActivities.Any())
                {
                    @foreach (var u in Model.UserActivities)
                    {
                        <tr>
                            <td class="fw-bold">@u.UserName</td>
                            <td>
                                <span class="role-badge @(u.Role == "Admin" ? "role-admin" : u.Role == "Manager" ? "role-manager" : "role-sales")">
                                    @u.Role
                                </span>
                            </td>
                            <td><span class="badge bg-light text-dark border">@u.LoginsCount</span></td>
                            <td class="fw-semibold text-primary">@u.CreatedRecordsCount</td>
                            <td class="text-muted">@u.UpdatedRecordsCount</td>
                            <td class="text-success fw-bold">@u.CompletedActivitiesCount</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">No user activity recorded.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
