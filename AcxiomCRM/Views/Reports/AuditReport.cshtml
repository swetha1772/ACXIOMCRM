@model AuditReportViewModel
@{
    ViewData["Title"] = "Security & Business Audit Report";
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h3 class="fw-bold mb-0">Security & Business Audit Report</h3>
        <p class="text-muted small mb-0">Compliance audit of authentication events, user role elevations and CRM modifications</p>
    </div>
    <div class="d-flex gap-2">
        <button onclick="window.print()" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-printer me-1"></i> Print / Export
        </button>
        <a asp-action="Index" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Reports Home
        </a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card p-3 bg-white text-center">
            <div class="text-muted small text-uppercase fw-semibold">Total Audit Events</div>
            <h3 class="fw-bold text-dark mb-0">@Model.TotalAuditEvents</h3>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card p-3 bg-white text-center">
            <div class="text-muted small text-uppercase fw-semibold">Successful Logins</div>
            <h3 class="fw-bold text-success mb-0">@Model.SuccessfulLogins</h3>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card p-3 bg-white text-center">
            <div class="text-muted small text-uppercase fw-semibold">Failed Login Attempts</div>
            <h3 class="fw-bold text-danger mb-0">@Model.FailedLogins</h3>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card p-3 bg-white text-center">
            <div class="text-muted small text-uppercase fw-semibold">Security Modifications</div>
            <h3 class="fw-bold text-warning mb-0">@Model.RoleAndSecurityChanges</h3>
        </div>
    </div>
</div>

<div class="card p-3 mb-4">
    <form method="get" asp-action="AuditReport" class="row g-2 align-items-center">
        <div class="col-md-4">
            <select name="moduleFilter" class="form-select">
                <option value="">All Entity Modules</option>
                <option value="Auth">Auth</option>
                <option value="Customer">Customer</option>
                <option value="Lead">Lead</option>
                <option value="Opportunity">Opportunity</option>
                <option value="User">User</option>
            </select>
        </div>
        <div class="col-md-4">
            <select name="actionFilter" class="form-select">
                <option value="">All Actions</option>
                <option value="Login">Login</option>
                <option value="Failed Login">Failed Login</option>
                <option value="Create">Create</option>
                <option value="Update">Update</option>
                <option value="Delete">Delete</option>
                <option value="Role Change">Role Change</option>
            </select>
        </div>
        <div class="col-md-4 d-flex gap-2">
            <button type="submit" class="btn btn-secondary px-3 w-100">Filter</button>
            <a asp-action="AuditReport" class="btn btn-outline-secondary px-3">Reset</a>
        </div>
    </form>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 small">
            <thead>
                <tr>
                    <th>Timestamp</th>
                    <th>User</th>
                    <th>Action</th>
                    <th>Module</th>
                    <th>Details</th>
                    <th>Result</th>
                    <th>IP</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.AuditLogs.Any())
                {
                    @foreach (var a in Model.AuditLogs)
                    {
                        <tr>
                            <td class="text-muted">@a.CreatedDate.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td class="fw-bold">@(a.UserName ?? a.UserId)</td>
                            <td>
                                <span class="badge @(a.Action == "Login" ? "bg-info text-dark" : a.Action.Contains("Failed") ? "bg-danger" : a.Action == "Create" ? "bg-success" : a.Action == "Role Change" ? "bg-warning text-dark" : "bg-secondary")">
                                    @a.Action
                                </span>
                            </td>
                            <td><span class="badge bg-light text-dark border">@a.EntityName</span></td>
                            <td>@a.Details</td>
                            <td><span class="badge @(a.Result == "Success" ? "bg-success" : "bg-danger")">@a.Result</span></td>
                            <td class="text-muted font-monospace">@a.IpAddress</td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">No audit events found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
