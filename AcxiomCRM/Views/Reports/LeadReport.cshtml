@model LeadReportViewModel
@{
    ViewData["Title"] = "Lead & Conversion Report";
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h3 class="fw-bold mb-0">Lead & Conversion Report</h3>
        <p class="text-muted small mb-0">Analysis of lead generation channels and conversion rates</p>
    </div>
    <div class="d-flex gap-2">
        <button onclick="window.print()" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-printer me-1"></i> Print / Export
        </button>
        <a asp-action="Index" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Reports Home
        </a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card p-3 bg-white text-center">
            <div class="text-muted small text-uppercase fw-semibold">Total Leads</div>
            <h3 class="fw-bold text-dark mb-0">@Model.TotalLeads</h3>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card p-3 bg-white text-center">
            <div class="text-muted small text-uppercase fw-semibold">Converted Deals</div>
            <h3 class="fw-bold text-success mb-0">@Model.ConvertedLeads</h3>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card p-3 bg-white text-center">
            <div class="text-muted small text-uppercase fw-semibold">Conversion Rate</div>
            <h3 class="fw-bold text-primary mb-0">@Model.ConversionRate%</h3>
        </div>
    </div>
</div>

<div class="card p-3 mb-4">
    <form method="get" asp-action="LeadReport" class="row g-2 align-items-center">
        <div class="col-md-4">
            <select name="sourceFilter" class="form-select">
                <option value="">All Sources</option>
                <option value="Website" selected="@(Model.SourceFilter == "Website")">Website</option>
                <option value="Referral" selected="@(Model.SourceFilter == "Referral")">Referral</option>
                <option value="Cold Call" selected="@(Model.SourceFilter == "Cold Call")">Cold Call</option>
                <option value="Campaign" selected="@(Model.SourceFilter == "Campaign")">Campaign</option>
                <option value="Partner" selected="@(Model.SourceFilter == "Partner")">Partner</option>
            </select>
        </div>
        <div class="col-md-4">
            <select name="statusFilter" class="form-select">
                <option value="">All Statuses</option>
                <option value="New" selected="@(Model.StatusFilter == "New")">New</option>
                <option value="Contacted" selected="@(Model.StatusFilter == "Contacted")">Contacted</option>
                <option value="Qualified" selected="@(Model.StatusFilter == "Qualified")">Qualified</option>
                <option value="Converted" selected="@(Model.StatusFilter == "Converted")">Converted</option>
                <option value="Lost" selected="@(Model.StatusFilter == "Lost")">Lost</option>
            </select>
        </div>
        <div class="col-md-4 d-flex gap-2">
            <button type="submit" class="btn btn-secondary px-3 w-100">Filter</button>
            <a asp-action="LeadReport" class="btn btn-outline-secondary px-3">Reset</a>
        </div>
    </form>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Lead Name</th>
                    <th>Company</th>
                    <th>Source</th>
                    <th>Status</th>
                    <th>Expected Value</th>
                    <th>Owner</th>
                    <th>Created</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Leads.Any())
                {
                    @foreach (var l in Model.Leads)
                    {
                        <tr>
                            <td><span class="badge bg-light text-dark border">@l.LeadCode</span></td>
                            <td class="fw-bold">@l.LeadName</td>
                            <td>@(l.CompanyName ?? "-")</td>
                            <td><span class="badge bg-light text-dark border">@l.Source</span></td>
                            <td>
                                <span class="badge badge-status badge-status-@(l.Status.ToLower())">
                                    @l.Status
                                </span>
                            </td>
                            <td class="fw-semibold">@l.ExpectedValue.ToString("C0")</td>
                            <td class="small">@(l.AssignedUser?.FullName ?? "Unassigned")</td>
                            <td class="small text-muted">@l.CreatedDate.ToString("yyyy-MM-dd")</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center py-4 text-muted">No lead records matching criteria.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
