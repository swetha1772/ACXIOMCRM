@model FollowUpReportViewModel
@{
    ViewData["Title"] = "Follow-Up Activity Report";
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h3 class="fw-bold mb-0">Follow-Up Activity Report</h3>
        <p class="text-muted small mb-0">Audit of planned, completed, missed and overdue customer follow-ups</p>
    </div>
    <div class="d-flex gap-2">
        <button onclick="window.print()" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-printer me-1"></i> Print / Export
        </button>
        <a asp-action="Index" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Reports Home
        </a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card p-3 bg-white text-center">
            <div class="text-muted small text-uppercase fw-semibold">Planned Tasks</div>
            <h3 class="fw-bold text-primary mb-0">@Model.TotalPlanned</h3>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card p-3 bg-white text-center">
            <div class="text-muted small text-uppercase fw-semibold">Completed</div>
            <h3 class="fw-bold text-success mb-0">@Model.TotalCompleted</h3>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card p-3 bg-white text-center">
            <div class="text-muted small text-uppercase fw-semibold">Missed</div>
            <h3 class="fw-bold text-secondary mb-0">@Model.TotalMissed</h3>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card p-3 bg-white text-center">
            <div class="text-muted small text-uppercase fw-semibold">Overdue</div>
            <h3 class="fw-bold text-danger mb-0">@Model.TotalOverdue</h3>
        </div>
    </div>
</div>

<div class="card p-3 mb-4">
    <form method="get" asp-action="FollowUpReport" class="row g-2 align-items-center">
        <div class="col-md-6">
            <select name="statusFilter" class="form-select">
                <option value="">All Statuses</option>
                <option value="Planned" selected="@(Model.StatusFilter == "Planned")">Planned</option>
                <option value="Completed" selected="@(Model.StatusFilter == "Completed")">Completed</option>
                <option value="Missed" selected="@(Model.StatusFilter == "Missed")">Missed</option>
                <option value="Cancelled" selected="@(Model.StatusFilter == "Cancelled")">Cancelled</option>
            </select>
        </div>
        <div class="col-md-6 d-flex gap-2">
            <button type="submit" class="btn btn-secondary px-3 w-100">Filter</button>
            <a asp-action="FollowUpReport" class="btn btn-outline-secondary px-3">Reset</a>
        </div>
    </form>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Subject</th>
                    <th>Type</th>
                    <th>Related Account</th>
                    <th>Date</th>
                    <th>Status</th>
                    <th>Assigned To</th>
                    <th>Remarks</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.FollowUps.Any())
                {
                    @foreach (var f in Model.FollowUps)
                    {
                        var isOverdue = f.Status == "Planned" && f.FollowUpDate.Date < DateTime.Today;
                        <tr>
                            <td class="fw-bold">
                                @f.Subject
                                @if (isOverdue)
                                {
                                    <span class="badge bg-danger ms-1">Overdue</span>
                                }
                            </td>
                            <td><span class="badge bg-light text-dark border">@f.FollowUpType</span></td>
                            <td>@(f.Customer?.CustomerName ?? f.Lead?.LeadName ?? "-")</td>
                            <td class="@(isOverdue ? "text-danger fw-bold" : "text-muted")">@f.FollowUpDate.ToString("yyyy-MM-dd")</td>
                            <td>
                                <span class="badge @(f.Status == "Planned" ? "bg-warning text-dark" : f.Status == "Completed" ? "bg-success" : "bg-secondary")">
                                    @f.Status
                                </span>
                            </td>
                            <td class="small">@(f.AssignedUser?.FullName ?? "Unassigned")</td>
                            <td class="small text-muted">@(f.Remarks ?? "-")</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">No follow-ups found matching filter.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
