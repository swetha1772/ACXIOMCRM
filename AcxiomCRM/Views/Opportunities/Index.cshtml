@model OpportunityListViewModel
@{
    ViewData["Title"] = "Opportunity Pipeline";
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h3 class="fw-bold mb-0">Sales Opportunities</h3>
        <p class="text-muted small mb-0">Manage deals, probability weighting and pipeline milestones</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i> New Opportunity
    </a>
</div>

<!-- Filters -->
<div class="card p-3 mb-4">
    <form method="get" asp-action="Index" class="row g-2 align-items-center">
        <div class="col-md-5">
            <div class="input-group">
                <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Search opportunity name or customer..." />
            </div>
        </div>
        <div class="col-md-3">
            <select name="stageFilter" class="form-select">
                <option value="">All Pipeline Stages</option>
                <option value="Qualification" selected="@(Model.StageFilter == "Qualification")">Qualification</option>
                <option value="Proposal" selected="@(Model.StageFilter == "Proposal")">Proposal</option>
                <option value="Negotiation" selected="@(Model.StageFilter == "Negotiation")">Negotiation</option>
                <option value="Won" selected="@(Model.StageFilter == "Won")">Won</option>
                <option value="Lost" selected="@(Model.StageFilter == "Lost")">Lost</option>
            </select>
        </div>
        <div class="col-md-2">
            <select name="statusFilter" class="form-select">
                <option value="">All Statuses</option>
                <option value="Open" selected="@(Model.StatusFilter == "Open")">Open</option>
                <option value="Won" selected="@(Model.StatusFilter == "Won")">Won</option>
                <option value="Lost" selected="@(Model.StatusFilter == "Lost")">Lost</option>
            </select>
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-secondary px-3 w-100">Filter</button>
            <a asp-action="Index" class="btn btn-outline-secondary px-3">Reset</a>
        </div>
    </form>
</div>

<!-- Table -->
<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Opportunity Name</th>
                    <th>Customer</th>
                    <th>Amount</th>
                    <th>Stage</th>
                    <th>Probability</th>
                    <th>Weighted Value</th>
                    <th>Expected Close</th>
                    <th>Owner</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Opportunities.Any())
                {
                    @foreach (var o in Model.Opportunities)
                    {
                        <tr>
                            <td class="fw-bold">
                                <a asp-action="Details" asp-route-id="@o.OpportunityId" class="text-decoration-none">
                                    @o.OpportunityName
                                </a>
                            </td>
                            <td>
                                <a asp-controller="Customers" asp-action="Details" asp-route-id="@o.CustomerId" class="text-secondary text-decoration-none">
                                    @(o.Customer?.CustomerName ?? "Customer #" + o.CustomerId)
                                </a>
                            </td>
                            <td class="fw-bold text-dark">@o.Amount.ToString("C0")</td>
                            <td>
                                <span class="badge badge-stage-@(o.Stage.ToLower())">
                                    @o.Stage
                                </span>
                            </td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="progress flex-grow-1 me-2" style="height: 6px; width: 60px;">
                                        <div class="progress-bar @(o.Probability >= 70 ? "bg-success" : o.Probability >= 40 ? "bg-warning" : "bg-info")" style="width: @o.Probability%"></div>
                                    </div>
                                    <span class="small fw-semibold">@o.Probability%</span>
                                </div>
                            </td>
                            <td class="text-primary fw-semibold">@o.WeightedAmount.ToString("C0")</td>
                            <td class="small @(o.ExpectedCloseDate.Date < DateTime.Today && o.Status == "Open" ? "text-danger fw-bold" : "text-muted")">
                                @o.ExpectedCloseDate.ToString("yyyy-MM-dd")
                            </td>
                            <td class="small">@(o.AssignedUser?.FullName ?? "Unassigned")</td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Details" asp-route-id="@o.OpportunityId" class="btn btn-outline-info" title="Details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@o.OpportunityId" class="btn btn-outline-primary" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <button type="button" class="btn btn-outline-danger" title="Delete" data-bs-toggle="modal" data-bs-target="#deleteOppModal-@o.OpportunityId">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>

                                <!-- Delete Modal -->
                                <div class="modal fade" id="deleteOppModal-@o.OpportunityId" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content text-start">
                                            <div class="modal-header">
                                                <h5 class="modal-title text-danger"><i class="bi bi-exclamation-triangle-fill me-2"></i> Confirm Delete</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body">
                                                Are you sure you want to delete opportunity <strong>@o.OpportunityName</strong>?
                                                This action is permanent and recorded in the audit log.
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                <form asp-action="Delete" asp-route-id="@o.OpportunityId" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-danger">Confirm Delete</button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9" class="text-center py-4 text-muted">
                            <i class="bi bi-inbox fs-2 d-block mb-1"></i> No opportunities found matching the filter criteria.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3">
            <span class="small text-muted">Showing page @Model.PageNumber of @Model.TotalPages (Total @Model.TotalItems opportunities)</span>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageNumber - 1)" asp-route-searchTerm="@Model.SearchTerm" asp-route-stageFilter="@Model.StageFilter">Previous</a>
                </li>
                @for (int p = 1; p <= Model.TotalPages; p++)
                {
                    <li class="page-item @(p == Model.PageNumber ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-searchTerm="@Model.SearchTerm" asp-route-stageFilter="@Model.StageFilter">@p</a>
                    </li>
                }
                <li class="page-item @(Model.PageNumber >= Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageNumber + 1)" asp-route-searchTerm="@Model.SearchTerm" asp-route-stageFilter="@Model.StageFilter">Next</a>
                </li>
            </ul>
        </div>
    }
</div>
