@{
    ViewData["Title"] = "Access Denied";
}

<div class="row justify-content-center pt-5">
    <div class="col-md-6 text-center">
        <div class="card shadow-sm border-0 p-5">
            <div class="mb-3">
                <i class="bi bi-shield-x text-danger" style="font-size: 4rem;"></i>
            </div>
            <h3 class="fw-bold text-danger">Access Restricted</h3>
            <p class="text-muted mt-2">
                Your assigned role does not have authorization to view this resource. 
                Role-based access boundaries are strictly enforced on the server.
            </p>
            <div class="mt-4">
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4">
                    <i class="bi bi-arrow-left me-1"></i> Return to Dashboard
                </a>
            </div>
        </div>
    </div>
</div>
