@model Activity
@{
    ViewData["Title"] = $"Activity - {Model.Subject}";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <div class="d-flex align-items-center gap-2">
            <h3 class="fw-bold mb-0">@Model.Subject</h3>
            <span class="badge @(Model.ActivityType == "Meeting" ? "bg-primary" : Model.ActivityType == "Call" ? "bg-info text-dark" : Model.ActivityType == "Email" ? "bg-secondary" : "bg-dark")">
                @Model.ActivityType
            </span>
            <span class="badge bg-success">@Model.Status</span>
        </div>
        <p class="text-muted small mb-0">Recorded on @Model.ActivityDate.ToString("MMMM dd, yyyy HH:mm")</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.ActivityId" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-pencil me-1"></i> Edit Activity
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Back to List
        </a>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card p-4">
            <h6 class="fw-bold text-dark border-bottom pb-2 mb-3"><i class="bi bi-info-circle me-1 text-primary"></i> Activity Details</h6>
            <dl class="row mb-0">
                <dt class="col-sm-4 text-muted">Activity Type</dt>
                <dd class="col-sm-8 fw-semibold">@Model.ActivityType</dd>

                <dt class="col-sm-4 text-muted">Date & Time</dt>
                <dd class="col-sm-8">@Model.ActivityDate.ToString("yyyy-MM-dd HH:mm")</dd>

                <dt class="col-sm-4 text-muted">Assigned User</dt>
                <dd class="col-sm-8">@(Model.AssignedUser?.FullName ?? "Unassigned")</dd>

                @if (Model.Customer != null)
                {
                    <dt class="col-sm-4 text-muted">Related Customer</dt>
                    <dd class="col-sm-8">
                        <a asp-controller="Customers" asp-action="Details" asp-route-id="@Model.CustomerId">
                            @Model.Customer.CustomerName (@Model.Customer.CustomerCode)
                        </a>
                    </dd>
                }

                @if (Model.Lead != null)
                {
                    <dt class="col-sm-4 text-muted">Related Lead</dt>
                    <dd class="col-sm-8">
                        <a asp-controller="Leads" asp-action="Details" asp-route-id="@Model.LeadId">
                            @Model.Lead.LeadName (@Model.Lead.LeadCode)
                        </a>
                    </dd>
                }

                <dt class="col-sm-4 text-muted">Summary & Notes</dt>
                <dd class="col-sm-8 text-muted">@(Model.Description ?? "No description logged.")</dd>

                <dt class="col-sm-4 text-muted">Creation Timestamp</dt>
                <dd class="col-sm-8 small text-secondary">@Model.CreatedDate.ToString("yyyy-MM-dd HH:mm:ss") UTC</dd>
            </dl>
        </div>
    </div>
</div>
