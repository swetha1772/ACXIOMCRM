@model DashboardViewModel
@{
    ViewData["Title"] = "Executive Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h3 class="fw-bold mb-0">Sales & Pipeline Dashboard</h3>
        <p class="text-muted small mb-0">Live CRM metrics, conversion tracking & pipeline visualization</p>
    </div>

    <!-- Date Filters (Section 4.3) -->
    <div class="d-flex align-items-center gap-2">
        <div class="btn-group shadow-sm" role="group">
            <a asp-action="Index" asp-route-filter="all" class="btn btn-sm @(Model.Filter == "all" ? "btn-primary" : "btn-outline-secondary")">All Time</a>
            <a asp-action="Index" asp-route-filter="today" class="btn btn-sm @(Model.Filter == "today" ? "btn-primary" : "btn-outline-secondary")">Today</a>
            <a asp-action="Index" asp-route-filter="thisweek" class="btn btn-sm @(Model.Filter == "thisweek" ? "btn-primary" : "btn-outline-secondary")">This Week</a>
            <a asp-action="Index" asp-route-filter="thismonth" class="btn btn-sm @(Model.Filter == "thismonth" ? "btn-primary" : "btn-outline-secondary")">This Month</a>
        </div>
    </div>
</div>

<!-- 8 KPI Cards (Section 17.11) -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card kpi-card p-3 bg-white" style="border-left-color: #3b82f6;">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small fw-semibold text-uppercase">Customers</div>
                    <h3 class="fw-bold mb-0 text-dark">@Model.TotalCustomers</h3>
                    <div class="text-secondary small">Total in scope</div>
                </div>
                <div class="kpi-icon bg-light text-primary">
                    <i class="bi bi-people-fill"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-6 col-md-3">
        <div class="card kpi-card p-3 bg-white" style="border-left-color: #06b6d4;">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small fw-semibold text-uppercase">Total Leads</div>
                    <h3 class="fw-bold mb-0 text-dark">@Model.TotalLeads</h3>
                    <div class="text-info small fw-semibold">@Model.OpenLeads Open</div>
                </div>
                <div class="kpi-icon bg-light text-info">
                    <i class="bi bi-funnel-fill"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-6 col-md-3">
        <div class="card kpi-card p-3 bg-white" style="border-left-color: #8b5cf6;">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small fw-semibold text-uppercase">Opportunities</div>
                    <h3 class="fw-bold mb-0 text-dark">@Model.TotalOpportunities</h3>
                    <div class="text-primary small fw-semibold">@Model.OpenOpportunities Active</div>
                </div>
                <div class="kpi-icon bg-light text-primary">
                    <i class="bi bi-briefcase-fill"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-6 col-md-3">
        <div class="card kpi-card p-3 bg-white" style="border-left-color: #10b981;">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small fw-semibold text-uppercase">Won Deals</div>
                    <h3 class="fw-bold mb-0 text-success">@Model.WonOpportunities</h3>
                    <div class="text-muted small">@Model.LostOpportunities Lost</div>
                </div>
                <div class="kpi-icon bg-light text-success">
                    <i class="bi bi-trophy-fill"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-6 col-md-3">
        <div class="card kpi-card p-3 bg-white" style="border-left-color: #f59e0b;">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small fw-semibold text-uppercase">Open Pipeline</div>
                    <h4 class="fw-bold mb-0 text-warning">@Model.TotalPipelineValue.ToString("C0")</h4>
                    <div class="text-secondary small">Gross active sum</div>
                </div>
                <div class="kpi-icon bg-light text-warning">
                    <i class="bi bi-currency-dollar"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-6 col-md-3">
        <div class="card kpi-card p-3 bg-white" style="border-left-color: #ec4899;">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small fw-semibold text-uppercase">Weighted Value</div>
                    <h4 class="fw-bold mb-0 text-danger">@Model.WeightedPipelineValue.ToString("C0")</h4>
                    <div class="text-secondary small">Amount &times; Prob / 100</div>
                </div>
                <div class="kpi-icon bg-light text-danger">
                    <i class="bi bi-graph-up-arrow"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-6 col-md-3">
        <div class="card kpi-card p-3 bg-white" style="border-left-color: #6366f1;">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small fw-semibold text-uppercase">Pending Follow-Ups</div>
                    <h3 class="fw-bold mb-0 text-primary">@Model.PendingFollowUps</h3>
                    <div class="text-secondary small">Actions planned</div>
                </div>
                <div class="kpi-icon bg-light text-primary">
                    <i class="bi bi-calendar-event-fill"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-6 col-md-3">
        <div class="card kpi-card p-3 bg-white" style="border-left-color: #14b8a6;">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small fw-semibold text-uppercase">Win Ratio</div>
                    <h3 class="fw-bold mb-0 text-dark">
                        @(Model.WonOpportunities + Model.LostOpportunities > 0 ? (Math.Round((decimal)Model.WonOpportunities / (Model.WonOpportunities + Model.LostOpportunities) * 100, 0) + "%") : "N/A")
                    </h3>
                    <div class="text-secondary small">Closed outcomes</div>
                </div>
                <div class="kpi-icon bg-light text-info">
                    <i class="bi bi-pie-chart-fill"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Charts Row (Section 17.12: Chart.js Lead Status, Pipeline, Monthly Sales) -->
<div class="row g-3 mb-4">
    <div class="col-lg-4">
        <div class="card p-3 h-100">
            <h6 class="fw-bold text-dark mb-3"><i class="bi bi-pie-chart me-1 text-primary"></i> Lead Status Breakdown</h6>
            <div style="position: relative; height: 260px;">
                <canvas id="leadStatusChart"></canvas>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card p-3 h-100">
            <h6 class="fw-bold text-dark mb-3"><i class="bi bi-bar-chart me-1 text-success"></i> Opportunity Pipeline by Stage</h6>
            <div style="position: relative; height: 260px;">
                <canvas id="pipelineChart"></canvas>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card p-3 h-100">
            <h6 class="fw-bold text-dark mb-3"><i class="bi bi-graph-up me-1 text-info"></i> Won Revenue Trend (Past 6 Months)</h6>
            <div style="position: relative; height: 260px;">
                <canvas id="monthlySalesChart"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Tables Row: Upcoming Follow-ups & Recent Activities -->
<div class="row g-3">
    <div class="col-lg-6">
        <div class="card p-3 h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-bold text-dark mb-0"><i class="bi bi-calendar-check me-1 text-warning"></i> Upcoming & Overdue Follow-Ups</h6>
                <a asp-controller="FollowUps" asp-action="Index" class="btn btn-sm btn-outline-primary">View All</a>
            </div>
            @if (Model.UpcomingFollowUps.Any())
            {
                <div class="list-group list-group-flush">
                    @foreach (var fu in Model.UpcomingFollowUps)
                    {
                        <div class="list-group-item px-0 d-flex justify-content-between align-items-center">
                            <div>
                                <div class="fw-semibold">
                                    @fu.Subject
                                    @if (fu.IsOverdue)
                                    {
                                        <span class="badge bg-danger ms-1">Overdue</span>
                                    }
                                </div>
                                <div class="small text-muted">
                                    <span class="badge bg-light text-dark me-1">@fu.Type</span>
                                    <span>Date: @fu.Date.ToString("MMM dd, yyyy")</span>
                                    @if (!string.IsNullOrEmpty(fu.RelatedName))
                                    {
                                        <span class="ms-1">&bull; @fu.RelatedName</span>
                                    }
                                </div>
                            </div>
                            <div>
                                <form asp-controller="FollowUps" asp-action="Complete" asp-route-id="@fu.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-success btn-sm" title="Mark Done">
                                        <i class="bi bi-check-lg"></i> Complete
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-muted text-center py-4 my-auto">No pending follow-up tasks scheduled.</p>
            }
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card p-3 h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-bold text-dark mb-0"><i class="bi bi-clock-history me-1 text-secondary"></i> Recent Activities</h6>
                <a asp-controller="Activities" asp-action="Index" class="btn btn-sm btn-outline-primary">View All</a>
            </div>
            @if (Model.RecentActivities.Any())
            {
                <div class="table-responsive">
                    <table class="table table-sm table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Type</th>
                                <th>Subject</th>
                                <th>Related To</th>
                                <th>Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var act in Model.RecentActivities)
                            {
                                <tr>
                                    <td>
                                        <span class="badge bg-secondary">@act.Type</span>
                                    </td>
                                    <td class="fw-semibold">@act.Subject</td>
                                    <td class="small text-muted">@(act.RelatedName ?? "-")</td>
                                    <td class="small text-muted">@act.Date.ToString("MMM dd, yyyy")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted text-center py-4 my-auto">No recent activities logged.</p>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Chart 1: Lead Status
        const leadCtx = document.getElementById('leadStatusChart');
        if (leadCtx) {
            new Chart(leadCtx, {
                type: 'doughnut',
                data: {
                    labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.LeadStatusLabels)),
                    datasets: [{
                        data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.LeadStatusCounts)),
                        backgroundColor: ['#38bdf8', '#f59e0b', '#22c55e', '#ef4444', '#a855f7'],
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'bottom' }
                    }
                }
            });
        }

        // Chart 2: Pipeline by Stage
        const pipeCtx = document.getElementById('pipelineChart');
        if (pipeCtx) {
            new Chart(pipeCtx, {
                type: 'bar',
                data: {
                    labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PipelineStageLabels)),
                    datasets: [{
                        label: 'Stage Amount ($)',
                        data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PipelineStageAmounts)),
                        backgroundColor: '#3b82f6',
                        borderRadius: 4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        y: { beginAtZero: true }
                    }
                }
            });
        }

        // Chart 3: Monthly Sales Trend
        const salesCtx = document.getElementById('monthlySalesChart');
        if (salesCtx) {
            new Chart(salesCtx, {
                type: 'line',
                data: {
                    labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlySalesLabels)),
                    datasets: [{
                        label: 'Won Revenue ($)',
                        data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlySalesAmounts)),
                        borderColor: '#10b981',
                        backgroundColor: 'rgba(16, 185, 129, 0.1)',
                        fill: true,
                        tension: 0.3
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        y: { beginAtZero: true }
                    }
                }
            });
        }
    </script>
}
