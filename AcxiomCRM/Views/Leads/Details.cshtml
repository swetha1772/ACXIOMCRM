@model Lead
@{
    ViewData["Title"] = $"Lead - {Model.LeadName}";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <div class="d-flex align-items-center gap-2">
            <h3 class="fw-bold mb-0">@Model.LeadName</h3>
            <span class="badge badge-status badge-status-@(Model.Status.ToLower())">@Model.Status</span>
            <span class="badge bg-light text-dark border">@Model.LeadCode</span>
        </div>
        <p class="text-muted small mb-0">Created on @Model.CreatedDate.ToString("MMMM dd, yyyy")</p>
    </div>
    <div class="d-flex gap-2">
        @if (Model.Status != "Converted")
        {
            <a asp-action="Convert" asp-route-id="@Model.LeadId" class="btn btn-success btn-sm">
                <i class="bi bi-arrow-repeat me-1"></i> Convert Lead
            </a>
        }
        <a asp-controller="FollowUps" asp-action="Create" asp-route-leadId="@Model.LeadId" class="btn btn-outline-warning btn-sm">
            <i class="bi bi-calendar-plus me-1"></i> Follow-Up
        </a>
        <a asp-controller="Activities" asp-action="Create" asp-route-leadId="@Model.LeadId" class="btn btn-outline-info btn-sm">
            <i class="bi bi-telephone-plus me-1"></i> Log Activity
        </a>
        <a asp-action="Edit" asp-route-id="@Model.LeadId" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-pencil me-1"></i> Edit
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Back to List
        </a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-4">
        <div class="card p-3 mb-3">
            <h6 class="fw-bold text-dark border-bottom pb-2"><i class="bi bi-person-lines-fill me-1 text-primary"></i> Prospect Info</h6>
            <dl class="row small mb-0">
                <dt class="col-sm-5 text-muted">Company</dt>
                <dd class="col-sm-7 fw-semibold">@(Model.CompanyName ?? "-")</dd>

                <dt class="col-sm-5 text-muted">Email</dt>
                <dd class="col-sm-7"><a href="mailto:@Model.Email">@Model.Email</a></dd>

                <dt class="col-sm-5 text-muted">Phone</dt>
                <dd class="col-sm-7">@Model.Phone</dd>

                <dt class="col-sm-5 text-muted">Source</dt>
                <dd class="col-sm-7"><span class="badge bg-light text-dark border">@Model.Source</span></dd>

                <dt class="col-sm-5 text-muted">Priority</dt>
                <dd class="col-sm-7">
                    <span class="badge @(Model.Priority == "High" ? "bg-danger" : Model.Priority == "Medium" ? "bg-warning text-dark" : "bg-secondary")">
                        @Model.Priority
                    </span>
                </dd>

                <dt class="col-sm-5 text-muted">Expected Value</dt>
                <dd class="col-sm-7 fw-bold text-success">@Model.ExpectedValue.ToString("C0")</dd>

                <dt class="col-sm-5 text-muted">Assigned To</dt>
                <dd class="col-sm-7 fw-semibold">@(Model.AssignedUser?.FullName ?? "Unassigned")</dd>

                @if (Model.ConvertedCustomerId != null)
                {
                    <dt class="col-sm-5 text-muted">Converted Customer</dt>
                    <dd class="col-sm-7">
                        <a asp-controller="Customers" asp-action="Details" asp-route-id="@Model.ConvertedCustomerId" class="fw-bold text-primary">
                            <i class="bi bi-check-circle-fill text-success me-1"></i> View Customer
                        </a>
                    </dd>
                }
            </dl>
        </div>

        @if (!string.IsNullOrEmpty(Model.Notes))
        {
            <div class="card p-3">
                <h6 class="fw-bold text-dark border-bottom pb-2"><i class="bi bi-card-text me-1 text-secondary"></i> Discovery Notes</h6>
                <p class="small text-muted mb-0">@Model.Notes</p>
            </div>
        }
    </div>

    <div class="col-lg-8">
        <div class="card">
            <div class="card-header bg-white">
                <ul class="nav nav-tabs card-header-tabs" id="leadTabs" role="tablist">
                    <li class="nav-item">
                        <button class="nav-link active" id="lead-fu-tab" data-bs-toggle="tab" data-bs-target="#lead-fu" type="button" role="tab">
                            Follow-Ups (@Model.FollowUps.Count)
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link" id="lead-act-tab" data-bs-toggle="tab" data-bs-target="#lead-act" type="button" role="tab">
                            Activities (@Model.Activities.Count)
                        </button>
                    </li>
                </ul>
            </div>
            <div class="card-body">
                <div class="tab-content">
                    <div class="tab-pane fade show active" id="lead-fu" role="tabpanel">
                        @if (Model.FollowUps.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-sm table-hover align-middle">
                                    <thead>
                                        <tr>
                                            <th>Subject</th>
                                            <th>Type</th>
                                            <th>Date</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var fu in Model.FollowUps)
                                        {
                                            <tr>
                                                <td class="fw-semibold">@fu.Subject</td>
                                                <td><span class="badge bg-light text-dark border">@fu.FollowUpType</span></td>
                                                <td class="small">@fu.FollowUpDate.ToString("yyyy-MM-dd")</td>
                                                <td><span class="badge bg-secondary">@fu.Status</span></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <p class="text-muted text-center py-3 mb-0">No follow-ups recorded for this lead.</p>
                        }
                    </div>

                    <div class="tab-pane fade" id="lead-act" role="tabpanel">
                        @if (Model.Activities.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-sm table-hover align-middle">
                                    <thead>
                                        <tr>
                                            <th>Type</th>
                                            <th>Subject</th>
                                            <th>Date</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var act in Model.Activities)
                                        {
                                            <tr>
                                                <td><span class="badge bg-secondary">@act.ActivityType</span></td>
                                                <td class="fw-semibold">@act.Subject</td>
                                                <td class="small">@act.ActivityDate.ToString("yyyy-MM-dd")</td>
                                                <td><span class="badge bg-success">@act.Status</span></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <p class="text-muted text-center py-3 mb-0">No activities logged for this lead.</p>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
